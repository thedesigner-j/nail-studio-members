# Supabase project (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Full public URL this app is deployed at (used for OAuth redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google Cloud OAuth client (Google Cloud Console > APIs & Services > Credentials)
# Authorized redirect URI: {NEXT_PUBLIC_SITE_URL}/api/calendar/callback
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# The Webflow site origin that is allowed to iframe-embed this app
WEBFLOW_SITE_ORIGIN=https://yourbusiness.webflow.io
