# Supabase project (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Full public URL this app is deployed at (used for OAuth redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google Cloud OAuth client (Google Cloud Console > APIs & Services > Credentials)
# Authorized redirect URI: {NEXT_PUBLIC_SITE_URL}/api/calendar/callback
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# The Webflow site origin that is allowed to iframe-embed this app
WEBFLOW_SITE_ORIGIN=https://yourbusiness.webflow.io

# Stripe (booking deposits) — dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
# From the webhook endpoint you create at dashboard.stripe.com/webhooks
# (or `stripe listen` for local dev) — see README for the events to send.
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-signing-secret

# Resend (booking confirmation + reminder emails) — resend.com/api-keys
RESEND_API_KEY=re_your-resend-api-key
# Must be on a domain verified in Resend; otherwise emails can only be sent
# to the address you signed up to Resend with. Defaults to Resend's shared
# onboarding@resend.dev if unset (fine for testing only).
EMAIL_FROM=Nail Studio <you@yourdomain.com>
